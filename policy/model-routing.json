{
  "version": 4,
  "mode": "advisory-with-static-validation",
  "default_profile": "inherit",
  "max_parallel_subagents": 2,
  "roles": {
    "frontend": {
      "default_tier": "economy",
      "default_effort": "low",
      "risk_class": "normal"
    },
    "backend": {
      "default_tier": "balanced",
      "default_effort": "medium",
      "risk_class": "elevated"
    },
    "database": {
      "default_tier": "balanced",
      "default_effort": "medium",
      "risk_class": "elevated"
    },
    "security": {
      "default_tier": "balanced",
      "default_effort": "medium",
      "risk_class": "critical"
    },
    "reviewer": {
      "default_tier": "economy",
      "default_effort": "low",
      "risk_class": "elevated"
    },
    "optimizer": {
      "default_tier": "economy",
      "default_effort": "low",
      "risk_class": "normal"
    },
    "tester": {
      "default_tier": "economy",
      "default_effort": "low",
      "risk_class": "normal"
    }
  },
  "profiles": {
    "inherit": {
      "description": "No explicit model: inherit account-supported Codex model; safe starter.",
      "tier_models": {
        "economy": null,
        "balanced": null,
        "deep": null
      }
    },
    "example": {
      "description": "Documentation example ONLY: requires confirmed access and explicit apply.",
      "tier_models": {
        "economy": "gpt-6-luna",
        "balanced": "gpt-6.1-sol",
        "deep": "gpt-6.1-sol"
      }
    }
  },
  "escalation": {
    "allowed_trigger_codes": [
      "FAILED_TARGETED_TEST_TWICE",
      "UNCLEAR_CROSS_LAYER_ROOT_CAUSE",
      "CONFIRMED_HIGH_SECURITY_RISK",
      "HIGH_RISK_MIGRATION",
      "UNRESOLVED_REVIEW_FINDING"
    ],
    "max_escalations_per_task": 1,
    "approval_required": true,
    "override_target": "deep",
    "never_escalate_only_for_style": true
  },
  "routing": {
    "trivial_max_files": 2,
    "default_max_delegations": 1,
    "max_delegations_complex": 2,
    "never_delegate_for": [
      "format",
      "lint",
      "simple_css",
      "documentation_only"
    ],
    "tool_first": [
      "lint",
      "typecheck",
      "unit_test",
      "semgrep",
      "sonar",
      "dependency_audit"
    ]
  },
  "reporting": {
    "require_task_summary": true,
    "require_reason_for_escalation": true,
    "avoid_full_source_output": true
  }
}
