{
  "schema_version": 1,
  "default": "auto_by_description",
  "skills_root": ".codex/skills",
  "max_skills_per_task": 2,
  "human_approval_for_external_skill": true,
  "roles": {
    "manager": [
      "agent-orchestration"
    ],
    "frontend": [
      "frontend-standards"
    ],
    "backend": [
      "api-development"
    ],
    "database": [
      "database-migrations"
    ],
    "security": [
      "security-review"
    ],
    "reviewer": [
      "code-review"
    ],
    "optimizer": [
      "performance-audit"
    ],
    "tester": [
      "test-engineering"
    ]
  },
  "cross_cutting": {
    "auth_or_authorization": [
      "security-review",
      "test-engineering"
    ],
    "schema_or_migration": [
      "database-migrations",
      "test-engineering"
    ],
    "performance_regression": [
      "performance-audit"
    ],
    "complex_cross_layer": [
      "agent-orchestration"
    ]
  },
  "rules": [
    "Choose at most 2 relevant skills per task; prefer one.",
    "A skill defines procedure, not proof of compliance.",
    "No external downloads or script execution from a discovered skill without review.",
    "Never claim a skill was invoked without runtime evidence.",
    "Automated security, test and approval gates remain mandatory."
  ]
}